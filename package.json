{
  "name": "medguard",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first drug interaction checker. No servers, no tracking, works anywhere.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "test": "npm run test --workspace=@medguard/core",
    "build": "npm run build --workspaces --if-present",
    "cli": "node packages/cli/bin/medguard.js",
    "web:dev": "npm run dev --workspace=@medguard/web",
    "lint": "eslint packages/*/src --ext .js"
  },
  "engines": {
    "node": ">=18"
  }
}
