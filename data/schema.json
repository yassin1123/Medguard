{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MedGuard Interaction Dataset",
  "description": "The canonical shape for a MedGuard drug dataset. Drop your real data in as a file matching this schema, then point the loader at it.",
  "type": "object",
  "required": [
    "meta",
    "drugs"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "source",
        "version",
        "updated"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Where the data came from, e.g. 'openFDA' or 'DrugBank open data'."
        },
        "version": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "format": "date",
          "description": "ISO date the dataset was last refreshed."
        },
        "license": {
          "type": "string"
        }
      }
    },
    "drugs": {
      "type": "array",
      "description": "Every known drug. `id` is the stable key used by interactions.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable slug, e.g. 'warfarin'."
          },
          "name": {
            "type": "string",
            "description": "Primary display name."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Brand names and common alternates, e.g. ['Coumadin']."
          },
          "class": {
            "type": "string",
            "description": "Optional drug class, e.g. 'anticoagulant'."
          }
        }
      }
    }
  }
}
